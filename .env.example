# Copia questo file in `.env` e compila i valori. `.env` è nel .gitignore.
# In produzione gli stessi nomi vanno impostati su Cloudflare Pages:
# Settings → Variables and Secrets (LC_TOKEN e RESEND_API_KEY come "Secret").

# --- CRM (GoHighLevel / LeadConnector v2) ---
# Token della Private Integration del sub-account
LC_TOKEN=
# Location ID del sub-account (non è un segreto)
LC_LOCATION_ID=cDZduH9ZjNIo2598PTt2
# Pipeline e fase in cui entrano le richieste dal sito: ricavale con
#   node tools/list-pipelines.mjs
LC_PIPELINE_ID=
LC_STAGE_ID=
# Campo personalizzato dell'opportunità (Additional Info) dove scrivere il messaggio (facoltativo)
LC_MESSAGE_FIELD_ID=
# Facoltativo: header "Version" delle API (default v3, verificato sulla documentazione)
# LC_API_VERSION=v3

# --- Email di riserva alla segreteria (Resend) ---
# Usata solo se il CRM non risponde anche dopo il nuovo tentativo.
RESEND_API_KEY=
# Mittente su un dominio verificato in Resend
MAIL_FROM="Sito Torrino Sporting Center <sito@example.com>"
# Destinatario: la casella della segreteria
MAIL_TO=segreteria@example.com
